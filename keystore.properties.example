# Plantilla de keystore.properties (Sesion 14).
# Copiala como "keystore.properties" en la raiz del proyecto y completa los valores.
# keystore.properties y *.jks estan en .gitignore: NUNCA se suben al repositorio.
#
# Usa barras normales "/" en la ruta, tambien en Windows.
storeFile=C:/Users/<usuario>/claves/pharmamobil.jks
storePassword=<contrasena del almacen>
keyAlias=pharmamobil
keyPassword=<contrasena de la clave>

-- Copia local del inventario: es la fuente de verdad de la interfaz.
-- pendiente = 1: creado sin conexion, todavia no existe en PharmaSoft (id negativo).
CREATE TABLE producto (
    id               INTEGER NOT NULL PRIMARY KEY,
    nombre           TEXT    NOT NULL,
    precio           REAL    NOT NULL,
    stock            INTEGER NOT NULL,
    activo           INTEGER NOT NULL DEFAULT 1,
    categoria_id     INTEGER NOT NULL,
    categoria_nombre TEXT,
    pendiente        INTEGER NOT NULL DEFAULT 0
);

listarTodos:
SELECT * FROM producto ORDER BY pendiente DESC, nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1 ORDER BY id DESC;

insertar:
INSERT OR REPLACE INTO producto (id, nombre, precio, stock, activo, categoria_id, categoria_nombre, pendiente)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

eliminarPorId:
DELETE FROM producto WHERE id = ?;

-- Solo las filas que vinieron del servidor: lo pendiente nunca se borra al bajar.
borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

-- COALESCE evita el NULL de la tabla vacia; en Kotlin se garantiza un id negativo.
siguienteIdLocal:
SELECT COALESCE(MIN(id), 0) FROM producto;

contar:
SELECT COUNT(*) FROM producto;

-- Tabla de una sola fila con el instante de la ultima sincronizacion correcta.
CREATE TABLE sincronizacion (
    id        INTEGER NOT NULL PRIMARY KEY,
    ultima_ms INTEGER NOT NULL
);

guardarUltima:
INSERT OR REPLACE INTO sincronizacion (id, ultima_ms) VALUES (1, ?);

ultima:
SELECT ultima_ms FROM sincronizacion WHERE id = 1;
